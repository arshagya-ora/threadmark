  "cards": [
    {
      "dot": "cyan",
      "title": "01 · Follow the evidence",
      "items": [
        "A question retrieves four document passages plus matching graph neighbors, then calls the answer model.",
        "Answer text and numbered sources return through the API. The workspace opens source passages and the original PDF."
      ]
    },
    {
      "dot": "emerald",
      "title": "02 · Prepare the library",
      "items": [
        "PDF ingestion validates and chunks text, persists embeddings, and extracts a graph from the opening 5,000 characters.",
        "Chroma collections follow the embedding profile. Saved passages are re-indexed when that profile changes."
      ]
    },
    {
      "dot": "amber",
      "title": "03 · Know the boundaries",
      "items": [
        "The API has no user authentication. PDFs, catalog, vectors and metrics are local; provider keys stay in backend configuration.",
        "Selected hosted or local models receive role-specific text. The bundled sample uses prepared answers without model calls."
      ]
    }
  ]
